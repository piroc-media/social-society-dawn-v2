{%- comment -%}
  Renders Facebook / Pinterest share links.
  Accepts: share_link (absolute or relative URL), text (title), image (optional image object).
  WCAG: icons are aria-hidden with visually-hidden names; target="_blank" is announced via
  #a11y-new-window-message (layout/theme.liquid).
{%- endcomment -%}
{%- liquid
  assign share_url = share_link | default: product.url | default: request.path
  unless share_url contains '://'
    assign share_url = shop.url | append: share_url
  endunless
  assign share_text = text | default: product.title | default: page_title
  assign share_image = image | default: article.image | default: product.featured_image
-%}
<nav class="share-buttons" aria-label="Share this page">
  <div class="share-button--title">Share on:</div>

    <a
      target="_blank"
      rel="noopener"
      aria-describedby="a11y-new-window-message"
      href="//www.facebook.com/sharer.php?u={{ share_url | url_encode }}"
      class="btn--share share-facebook"
    >
      {%- render 'icon-facebook' -%}
      <span class="visually-hidden">Share on Facebook</span>
    </a>

  <a
      target="_blank"
      rel="noopener"
      aria-describedby="a11y-new-window-message"
      href="//pinterest.com/pin/create/button/?url={{ share_url | url_encode }}{% if share_image %}&amp;media={{ share_image | image_url: width: 1024 | url_encode }}{% endif %}&amp;description={{ share_text | url_param_escape }}"
      class="btn--share share-pinterest"
    >
      {%- render 'icon-pinterest' -%}
      <span class="visually-hidden">Pin on Pinterest</span>
    </a>
</nav>
