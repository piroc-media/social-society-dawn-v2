<div class="page-width page-width-full grid grid--gapless grid--2-col-tablet grid--1-col">
  {%- for block in section.blocks -%}
    {%- case block.type -%}
      {%- when 'image' -%}
        <div class="grid__item section-hero--image">
          <img
            src="{{ block.settings.image.src | image_url: width: 1440 }}"
            width="{{ block.settings.image.width }}"
            height="{{ block.settings.image.height }}"
            alt="{{ block.settings.image.alt | escape }}"
          >
        </div>

      {%- when 'content' -%}
        <div
          class="grid__item section-hero--content section-hero--color-scheme-{{ section.settings.color }}"
          style="background-color: var(--color-{{ section.settings.color }});"
        >
          {%- liquid
            comment
              Heading level: the first section on a page gets an <h1> so every page has one
              (WCAG 1.3.1 / 2.4.6); merchants can override via the "Headline tag" setting.
            endcomment
            assign heading_tag = section.settings.heading_tag | default: 'auto'
            if heading_tag == 'auto'
              if section.index == 1 and request.page_type != 'index'
                assign heading_tag = 'h1'
              else
                assign heading_tag = 'h2'
              endif
            endif
            assign headline_text = block.settings.headline | replace: '<p>', '' | replace: '</p>', ''
          -%}
          <div class="titles">
            {% if block.settings.subtitle != blank %}<div class="subtitle">{{ block.settings.subtitle }}</div>{% endif %}
            <{{ heading_tag }} class="headline">{{ headline_text }}</{{ heading_tag }}>
          </div>
          {% if block.settings.description != blank %}
            <div class="description">{{ block.settings.description }}</div>
          {% endif %}
        </div>
    {% endcase %}
  {%- endfor -%}
</div>

{% schema %}
{
  "name": "Hero",
  "tag": "section",
  "class": "section section-hero",
  "settings": [
    {
      "type": "select",
      "id": "color",
      "label": "Color",
      "options": [
        {
          "value": "violet",
          "label": "Violet"
        },
        {
          "value": "dark",
          "label": "Dark"
        },
        {
          "value": "blue",
          "label": "Blue"
        },
        {
          "value": "deep-blue",
          "label": "Deep blue"
        },
        {
          "value": "pink",
          "label": "Pink"
        },
        {
          "value": "green",
          "label": "Green"
        },
        {
          "value": "red",
          "label": "Red"
        },
        {
          "value": "teal",
          "label": "Teal"
        }
      ]
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Headline tag",
      "info": "Accessibility: every page needs exactly one H1. 'Auto' uses H1 when this is the first section on the page.",
      "default": "auto",
      "options": [
        { "value": "auto", "label": "Auto" },
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" }
      ]
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        }
      ]
    },
    {
      "type": "content",
      "name": "Content",
      "settings": [
        {
          "type": "richtext",
          "id": "subtitle",
          "label": "Subtitle"
        },
        {
          "type": "richtext",
          "id": "headline",
          "label": "Headline"
        },
        {
          "type": "richtext",
          "id": "description",
          "label": "Description"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero",
      "blocks": []
    }
  ]
}
{% endschema %}
