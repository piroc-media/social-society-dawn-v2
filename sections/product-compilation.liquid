<div class="page-width page-width-full">
  <div class="grid grid--gapless grid--1-col grid--2-col-tablet">
    <div class="grid__item content">
      {% comment %} SEO: the home page's h1 is the logo (Dawn header); demote any <h1> typed into this richtext {% endcomment %}
      <div class="heading">{{ section.settings.heading | replace: '<h1>', '<h2>' | replace: '</h1>', '</h2>' }}</div>
      <div class="subheading">{{ section.settings.subheading }}</div>

      <div class="products">
        <div class="grid grid--3-col">
          {% for block in section.blocks %}
            <div class="grid__item">
              <a href="{{ block.settings.product.url }}" class="product">
                <div class="media media--square">
                  {% comment %} image-only link: the product name is the link's accessible name (WCAG 2.4.4) {% endcomment %}
                  {{
                    block.settings.product.featured_media
                    | image_url: width: 750
                    | image_tag:
                      widths: '250, 375, 500, 750',
                      sizes: '(min-width: 750px) 250px, 33vw',
                      loading: 'lazy',
                      alt: block.settings.product.title
                  }}
                </div>
              </a>
            </div>
          {% endfor %}
        </div>
      </div>

      <a href="{{ section.settings.url }}" class="link">{{ section.settings.button_text }}</a>
    </div>

    <div class="grid__item image">
      {%- if section.settings.image != blank -%}
        {{
          section.settings.image
          | image_url: width: 1100
          | image_tag:
            widths: '375, 550, 750, 900, 1100',
            sizes: '(min-width: 750px) 40vw, 100vw',
            loading: 'lazy',
            alt: section.settings.image.alt
        }}
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Product Compilation",
  "class": "section-product-compilation",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "richtext",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Sub-Heading"
    },
    {
      "type": "url",
      "id": "url",
      "label": "CTA URL"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button label",
      "default": "SHOP NOW"
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product Compilation"
    }
  ]
}
{% endschema %}
