{{ 'section-blog-post.css' | asset_url | stylesheet_tag }}


{% if blog.handle == 'in-store-events' %}
  {% assign events_blog = true %}
{% endif %}

<article class="article-template blog-{{ blog.handle }}" itemscope itemtype="http://schema.org/BlogPosting">
  {% if events_blog %}
    <div class="event-hero page-width">
      <div class="grid grid--gapless grid--1-col grid--2-col-tablet">
        <div class="grid__item">
          <div class="media media--square">
            {% if article.metafields.custom.event_price == 'SOLD OUT' %}
              <div class="sold-out-banner"><img src="{{ 'sold-out-banner-v2.png' | file_img_url: '684x' }}" alt="sold out" width="342" height="125"></div>
            {% endif %}
            {{
              article.image
              | image_url: width: 1400
              | image_tag:
                widths: '375, 550, 750, 900, 1100, 1400',
                sizes: '(min-width: 750px) 50vw, 100vw',
                loading: 'eager',
                fetchpriority: 'high',
                alt: article.image.alt | default: article.title
            }}
          </div>
        </div>
        <div class="grid__item">
          <div class="event-hero--content">
            <h1 class="event-title">{{ article.title | escape }}</h1>

            {% assign event_button_text = article.metafields.custom.event_button_text %}
            {% assign event_button_link = article.metafields.custom.press_link_url %}
            {% if article.metafields.custom.event_custom_date != blank %}
              {% assign date = article.metafields.custom.event_custom_date %}
            {% else %}
              {% assign from_date = article.metafields.custom.event_date_time | date: '%B %d' %}
              {% assign to_date = article.metafields.custom.event_date_time_to | date: '%B %d' %}
              {% assign date = article.metafields.custom.event_date_time | date: '%B %d, %-I:%M%p' | append: ' - ' %}
              {% if from_date != to_date %}
                {% assign date = date | append: to_date | append: ' - ' %}
              {% endif %}
              {% assign to_time = article.metafields.custom.event_date_time_to | date: '%-I:%M%p' %}
              {% assign date = date | append: to_time %}
            {% endif %}
            <div class="event-date">{{ date }}</div>

            <div class="event-location">{{ article.metafields.custom.event_location }}</div>
            <div class="event-price">{{ article.metafields.custom.event_price }}</div>

            {% if event_button_text != blank %}
              {% if event_button_link != blank %}
                {% if article.metafields.custom.event_price != 'SOLD OUT' %}
                  <a href="{{ event_button_link }}" class="button">
                    {{ event_button_text }}
                  </a>
                  {% endif %}
                {% else %}
              <modal-opener data-modal="#PopupModal-event-rsvp">
                <button class="button" type="button" aria-haspopup="dialog" aria-controls="PopupModal-event-rsvp">
                  {{ event_button_text }}
                </button>
              </modal-opener>
                {% endif %}
            {% endif %}
          </div>
        </div>
      </div>
    </div>

    <div class="event-content page-width">
      <div class="event-description">{{ article.content }}</div>
      {% comment %}
        <div class="event-date">{{ date }}</div>

        <div class="event-location">{{ article.metafields.custom.event_location }}</div>

        <div class="event-price">{{ article.metafields.custom.event_price }}</div>

                  second RSVP button not needed
            {% if event_button_text != blank %}
            <modal-opener data-modal="#PopupModal-event-rsvp">
              <button class="button">
                {{ event_button_text }}
              </button>
            </modal-opener>
          {% endif %}
      {% endcomment %}
      <hr>

      <div class="event-share">
        <h2 class="event-share--title">SHARE THIS EVENT</h2>

        {% liquid
          assign share_url = article.url
          render 'share-buttons', share_link: share_url, text: article.title
        %}
      </div>
    </div>

    {% comment %}
      WCAG 2.2: the RSVP modal needs a [role="dialog"] container so Dawn's ModalDialog can
      move/trap focus (otherwise show() throws and focus stays behind the overlay), an
      accessible name, labelled fields, and a real close <button>. If the form was posted
      with errors the modal is re-opened so the error is visible and announced (3.3.1).
    {% endcomment %}
    <modal-dialog id="PopupModal-event-rsvp" class="event-rsvp">
      {% form 'contact', return_to: '/pages/thank-you-rsvp' %}
        <style>
          .event-rsvp .event-title {
            font-family: ABCROMCompressed-Heavy;
            font-size: 40px;
            line-height: 40px;
            color: var(--color-red);
            margin: 0 0 20px;
            white-space: break-spaces;
            max-width: 400px;
          }
        </style>
        <div role="dialog" aria-modal="true" aria-labelledby="EventRsvpTitle-{{ section.id }}" tabindex="-1" class="event-rsvp__dialog">
        <h2 class="event-title" id="EventRsvpTitle-{{ section.id }}">RSVP: {{ article.title | escape }}</h2>
        {%- if form.errors -%}
          <div class="form__message" role="alert" tabindex="-1" autofocus id="EventRsvp-email-error-{{ section.id }}">
            {% render 'icon-error' %}
            {{ form.errors.translated_fields.email | capitalize }}
            {{ form.errors.messages.email }}
          </div>
        {%- endif -%}
        <p class="caption"><span aria-hidden="true">*</span> Required field</p>
        <input type="hidden" name="contact[event_title]" value="{{ article.title | escape }}">
        <input type="hidden" name="contact[event_date]" value="{{ date | escape }}">

        <div class="first-name field">
          <input type="text" name="contact[first_name]" id="EventRsvp-first-name-{{ section.id }}" class="field__input" placeholder="First name" autocomplete="given-name" required aria-required="true">
          <label class="field__label" for="EventRsvp-first-name-{{ section.id }}">First name <span aria-hidden="true">*</span></label>
        </div>

        <div class="last-name field">
          <input type="text" name="contact[last_name]" id="EventRsvp-last-name-{{ section.id }}" class="field__input" placeholder="Last name" autocomplete="family-name" required aria-required="true">
          <label class="field__label" for="EventRsvp-last-name-{{ section.id }}">Last name <span aria-hidden="true">*</span></label>
        </div>

        <div class="phone field">
          <input type="tel" name="contact[phone]" id="EventRsvp-phone-{{ section.id }}" class="field__input" placeholder="Phone" autocomplete="tel">
          <label class="field__label" for="EventRsvp-phone-{{ section.id }}">Phone</label>
        </div>

        <div class="email field">
          <input
            type="email"
            name="contact[email]"
            id="EventRsvp-email-{{ section.id }}"
            class="field__input"
            placeholder="Email"
            autocomplete="email"
            spellcheck="false"
            autocapitalize="off"
            required
            aria-required="true"
            {% if form.errors contains 'email' %}
              aria-invalid="true"
              aria-describedby="EventRsvp-email-error-{{ section.id }}"
            {% endif %}
          >
          <label class="field__label" for="EventRsvp-email-{{ section.id }}">Email <span aria-hidden="true">*</span></label>
        </div>

        <div class="people field">
          <input type="number" min="1" inputmode="numeric" name="contact[people]" id="EventRsvp-people-{{ section.id }}" class="field__input" placeholder="Number of people" required aria-required="true">
          <label class="field__label" for="EventRsvp-people-{{ section.id }}">Number of people <span aria-hidden="true">*</span></label>
        </div>

        <div class="message field">
          <textarea name="contact[body]" id="EventRsvp-message-{{ section.id }}" class="text-area field__input" placeholder="Message"></textarea>
          <label class="form__label field__label" for="EventRsvp-message-{{ section.id }}">Message</label>
        </div>

        <div class="submit">
          <input type="submit" value="SUBMIT" class="button">
        </div>

        <button type="button" id="ModalClose-event-rsvp" class="event-rsvp--close" aria-label="{{ 'accessibility.close' | t }}">
          {% render 'icon-close' %}
        </button>
        </div>
      {% endform %}
    </modal-dialog>
  {% else %}
    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when '@app' -%}
          <div class="page-width{% if section.settings.page_width_narrow %} page-width--narrow{% endif %}">
            {% render block %}
          </div>
        {%- when 'featured_image' -%}
          {%- if article.image -%}
            <div
              class="article-template__hero-container{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}"
              {{ block.shopify_attributes }}
            >
              <div
                class="article-template__hero-{{ block.settings.image_height }} media"
                itemprop="image"
                {% if block.settings.image_height == 'adapt' and article.image %}
                  style="padding-bottom: {{ 1 | divided_by: article.image.aspect_ratio | times: 100 }}%;"
                {% endif %}
              >
                <img
                  srcset="
                    {% if article.image.width >= 350 %}{{ article.image | image_url: width: 350 }} 350w,{% endif %}
                    {% if article.image.width >= 750 %}{{ article.image | image_url: width: 750 }} 750w,{% endif %}
                    {% if article.image.width >= 1100 %}{{ article.image | image_url: width: 1100 }} 1100w,{% endif %}
                    {% if article.image.width >= 1500 %}{{ article.image | image_url: width: 1500 }} 1500w,{% endif %}
                    {% if article.image.width >= 2200 %}{{ article.image | image_url: width: 2200 }} 2200w,{% endif %}
                    {% if article.image.width >= 3000 %}{{ article.image | image_url: width: 3000 }} 3000w,{% endif %}
                    {{ article.image | image_url }} {{ article.image.width }}w
                  "
                  sizes="(min-width: {{ settings.page_width }}px) {{ settings.page_width | minus: 100 }}px, (min-width: 750px) calc(100vw - 10rem), 100vw"
                  src="{{ article.image | image_url: width: 1100 }}"
                  loading="eager"
                  fetchpriority="high"
                  width="{{ article.image.width }}"
                  height="{{ article.image.height }}"
                  alt="{{ article.image.alt | escape }}"
                >
              </div>
            </div>
          {%- endif -%}

        {%- when 'title' -%}
          <header
            class="page-width{% if section.settings.page_width_narrow %} page-width--narrow{% endif %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}"
            {{ block.shopify_attributes }}
          >
            <h1
              class="article-template__title"
              itemprop="headline"
            >
              {{ article.title | escape }}
            </h1>
            {%- if block.settings.blog_show_date -%}
              <span class="circle-divider caption-with-letter-spacing" itemprop="dateCreated pubdate datePublished">
                {{- article.published_at | time_tag: format: 'date' -}}
              </span>
            {%- endif -%}
            {%- if block.settings.blog_show_author -%}
              <span class="caption-with-letter-spacing" itemprop="author" itemscope itemtype="http://schema.org/Person">
                <span itemprop="name">{{ article.author }}</span>
              </span>
            {%- endif -%}
          </header>

        {%- when 'content' -%}
          <div
            class="article-template__content page-width{% if section.settings.page_width_narrow %} page-width--narrow{% endif %} rte{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
            itemprop="articleBody"
            {{ block.shopify_attributes }}
          >
            {{ article.content }}
          </div>

        {%- when 'share' -%}
          <div
            class="article-template__social-sharing page-width{% if section.settings.page_width_narrow %} page-width--narrow{% endif %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
            {{ block.shopify_attributes }}
          >
            {% assign share_url = request.origin | append: article.url %}
            {% render 'share-button', block: block, share_link: share_url %}
          </div>
      {%- endcase -%}
    {%- endfor -%}
  {% endif %}

  <div class="article-template__back element-margin-top center{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
    <a href="{{ blog.url }}" class="article-template__link link animate-arrow">
      <span class="icon-wrap">{% render 'icon-arrow' %}</span>
      Back to Events <!-- {{ 'blogs.article.back_to_blog' | t: title: blog.title }} -->
    </a>
  </div>
  {%- if blog.comments_enabled? -%}
    <div class="article-template__comment-wrapper background-secondary">
      <div
        id="comments"
        class="page-width{% if section.settings.page_width_narrow %} page-width--narrow{% endif %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
      >
        {%- if article.comments_count > 0 -%}
          {%- assign anchor_id = '#Comments-' | append: article.id -%}

          <h2 id="Comments-{{ article.id }}" tabindex="-1">
            {{ 'blogs.article.comments' | t: count: article.comments_count }}
          </h2>
          {% paginate article.comments by 5 %}
            <div class="article-template__comments">
              {%- if comment.status == 'pending' and comment.content -%}
                <article id="{{ comment.id }}" class="article-template__comments-comment">
                  {{ comment.content }}
                  <footer class="right">
                    <span class="circle-divider caption-with-letter-spacing">{{ comment.author }}</span>
                  </footer>
                </article>
              {%- endif -%}

              {%- for comment in article.comments -%}
                <article id="{{ comment.id }}" class="article-template__comments-comment">
                  {{ comment.content }}
                  <footer class="right">
                    <span class="circle-divider caption-with-letter-spacing">{{ comment.author }}</span
                    ><span class="caption-with-letter-spacing">
                      {{- comment.created_at | time_tag: format: 'date' -}}
                    </span>
                  </footer>
                </article>
              {%- endfor -%}
              {% render 'pagination', paginate: paginate, anchor: anchor_id %}
            </div>
          {% endpaginate %}
        {%- endif -%}
        {% form 'new_comment', article %}
          {%- liquid
            assign post_message = 'blogs.article.success'
            if blog.moderated? and comment.status == 'unapproved'
              assign post_message = 'blogs.article.success_moderated'
            endif
          -%}
          <h2>{{ 'blogs.article.comment_form_title' | t }}</h2>
          {%- if form.errors -%}
            <div class="form__message" role="alert">
              <h3 class="form-status caption-large text-body" tabindex="-1" autofocus>
                {% render 'icon-error' %}
                {{ 'templates.contact.form.error_heading' | t }}
              </h3>
            </div>
            <ul class="form-status-list caption-large">
              {%- for field in form.errors -%}
                <li>
                  <a href="#CommentForm-{{ field }}" class="link">
                    {%- if form.errors.translated_fields[field] contains 'author' -%}
                      {{ 'blogs.article.name' | t }}
                    {%- elsif form.errors.translated_fields[field] contains 'body' -%}
                      {{ 'blogs.article.message' | t }}
                    {%- else -%}
                      {{ form.errors.translated_fields[field] }}
                    {%- endif -%}
                    {{ form.errors.messages[field] }}
                  </a>
                </li>
              {%- endfor -%}
            </ul>
          {%- elsif form.posted_successfully? -%}
            <div class="form-status-list form__message" role="status">
              <h3 class="form-status" tabindex="-1" autofocus>
                {% render 'icon-success' %}
                {{ post_message | t }}
              </h3>
            </div>
          {%- endif -%}

          <div
            {% if blog.moderated? == false %}
              class="article-template__comments-fields"
            {% endif %}
          >
            <div class="article-template__comment-fields">
              <div class="field field--with-error">
                <input
                  type="text"
                  name="comment[author]"
                  id="CommentForm-author"
                  class="field__input"
                  autocomplete="name"
                  value="{{ form.author }}"
                  aria-required="true"
                  required
                  {% if form.errors contains 'author' %}
                    aria-invalid="true"
                    aria-describedby="CommentForm-author-error"
                  {% endif %}
                  placeholder="{{ 'blogs.article.name' | t }}"
                >
                <label class="field__label" for="CommentForm-author">
                  {{- 'blogs.article.name' | t }}
                  <span aria-hidden="true">*</span></label
                >
                {%- if form.errors contains 'author' -%}
                  <small id="CommentForm-author-error">
                    <span class="form__message">
                      {%- render 'icon-error' -%}
                      {{- 'blogs.article.name' | t }}
                      {{ form.errors.messages.author }}.</span
                    >
                  </small>
                {%- endif -%}
              </div>
              <div class="field field--with-error">
                <input
                  type="email"
                  name="comment[email]"
                  id="CommentForm-email"
                  autocomplete="email"
                  class="field__input"
                  value="{{ form.email }}"
                  autocorrect="off"
                  autocapitalize="off"
                  aria-required="true"
                  required
                  {% if form.errors contains 'email' %}
                    aria-invalid="true"
                    aria-describedby="CommentForm-email-error"
                  {% endif %}
                  placeholder="{{ 'blogs.article.email' | t }}"
                >
                <label class="field__label" for="CommentForm-email">
                  {{- 'blogs.article.email' | t }}
                  <span aria-hidden="true">*</span></label
                >
                {%- if form.errors contains 'email' -%}
                  <small id="CommentForm-email-error">
                    <span class="form__message">
                      {%- render 'icon-error' -%}
                      {{- 'blogs.article.email' | t }}
                      {{ form.errors.messages.email }}.</span
                    >
                  </small>
                {%- endif -%}
              </div>
            </div>
            <div class="field field--with-error">
              <textarea
                rows="5"
                name="comment[body]"
                id="CommentForm-body"
                class="text-area field__input"
                aria-required="true"
                required
                {% if form.errors contains 'body' %}
                  aria-invalid="true"
                  aria-describedby="CommentForm-body-error"
                {% endif %}
                placeholder="{{ 'blogs.article.message' | t }}"
              >{{ form.body }}</textarea>
              <label class="form__label field__label" for="CommentForm-body">
                {{- 'blogs.article.message' | t }}
                <span aria-hidden="true">*</span></label
              >
            </div>
            {%- if form.errors contains 'body' -%}
              <small id="CommentForm-body-error">
                <span class="form__message">
                  {%- render 'icon-error' -%}
                  {{- 'blogs.article.message' | t }}
                  {{ form.errors.messages.body }}.</span
                >
              </small>
            {%- endif -%}
          </div>
          {%- if blog.moderated? -%}
            <p class="article-template__comment-warning caption">{{ 'blogs.article.moderated' | t }}</p>
          {%- endif -%}
          <input type="submit" class="button" value="{{ 'blogs.article.post' | t }}">
        {% endform %}
      </div>
    </div>
  {%- endif -%}
</article>

<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    "articleBody": {{ article.content | strip_html | json }},
    "mainEntityOfPage": {
      "@type": "WebPage",
      "@id": {{ request.origin | append: article.url | json }}
    },
    "headline": {{ article.title | json }},
    "description": {{ article.excerpt_or_content | strip_html | truncate: 300 | json }},
    "dateModified": {{ article.updated_at | date: '%Y-%m-%dT%H:%M:%S%:z' | json }},
    {% if article.image %}
      "image": [
        {{ article | image_url: width: 1920 | prepend: "https:" | json }}
      ],
    {% endif %}
    "datePublished": {{ article.published_at | date: '%Y-%m-%dT%H:%M:%S%:z' | json }},
    "dateCreated": {{ article.created_at | date: '%Y-%m-%dT%H:%M:%S%:z' | json }},
    "author": {
      "@type": "Person",
      "name": {{ article.author | json }}
    },
    "publisher": {
      "@type": "Organization",
      "name": {{ shop.name | json }}
    }
  }
</script>

{%- comment -%}
  SEO: Event structured data for in-store events (Google "Events" rich results).
  Only output when a start date/time exists (required by schema.org). Fields come from
  the article metafields already used by the hero above.
{%- endcomment -%}
{%- if events_blog and article.metafields.custom.event_date_time != blank -%}
  {%- liquid
    assign event_start = article.metafields.custom.event_date_time | date: '%Y-%m-%dT%H:%M:%S%:z'
    assign event_end = article.metafields.custom.event_date_time_to | date: '%Y-%m-%dT%H:%M:%S%:z'
    assign price_raw = article.metafields.custom.event_price | strip | upcase
    assign event_sold_out = false
    if price_raw == 'SOLD OUT'
      assign event_sold_out = true
    endif
    assign event_price = ''
    if price_raw == 'FREE' or price_raw contains 'FREE'
      assign event_price = '0'
    elsif price_raw != blank and event_sold_out == false
      assign event_price = price_raw | remove: '$' | remove: ',' | split: '/' | first | split: ' ' | first
    endif
    assign event_url = request.origin | append: article.url
    assign ticket_url = article.metafields.custom.press_link_url | default: article.url
    unless ticket_url contains '//'
      assign ticket_url = request.origin | append: ticket_url
    endunless
  -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Event",
      "@id": {{ event_url | append: '#event' | json }},
      "name": {{ article.title | json }},
      "url": {{ event_url | json }},
      "startDate": {{ event_start | json }},
      {% if article.metafields.custom.event_date_time_to != blank %}
        "endDate": {{ event_end | json }},
      {% endif %}
      "eventAttendanceMode": "https://schema.org/OfflineEventAttendanceMode",
      "eventStatus": "https://schema.org/EventScheduled",
      {% if article.image %}
        "image": [{{ article.image | image_url: width: 1200 | prepend: 'https:' | json }}],
      {% endif %}
      {% if article.excerpt != blank %}
        "description": {{ article.excerpt | strip_html | json }},
      {% else %}
        "description": {{ article.content | strip_html | truncate: 300 | json }},
      {% endif %}
      "location": {
        "@type": "Place",
        "name": {{ article.metafields.custom.event_location | default: shop.name | json }},
        {% if shop.address.address1 != blank %}
          "address": {
            "@type": "PostalAddress",
            "streetAddress": {{ shop.address.street | json }},
            "addressLocality": {{ shop.address.city | json }},
            "addressRegion": {{ shop.address.province_code | json }},
            "postalCode": {{ shop.address.zip | json }},
            "addressCountry": {{ shop.address.country_code | json }}
          }
        {% else %}
          "address": {{ article.metafields.custom.event_location | default: shop.name | json }}
        {% endif %}
      },
      "organizer": {
        "@type": "Organization",
        "name": {{ shop.name | json }},
        "url": {{ request.origin | json }}
      },
      {% if event_price != blank or event_sold_out %}
        "offers": {
          "@type": "Offer",
          "url": {{ ticket_url | json }},
          "validFrom": {{ article.published_at | date: '%Y-%m-%dT%H:%M:%S%:z' | json }},
          {% if event_price != blank %}
            "price": {{ event_price | json }},
            "priceCurrency": {{ shop.currency | json }},
          {% endif %}
          "availability": {% if event_sold_out %}"https://schema.org/SoldOut"{% else %}"https://schema.org/InStock"{% endif %}
        },
      {% endif %}
      "performer": {
        "@type": "Organization",
        "name": {{ shop.name | json }}
      }
    }
  </script>
{%- endif -%}

{% schema %}
{
  "name": "Events article",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "checkbox",
      "id": "page_width_narrow",
      "label": "page width narrow",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "featured_image",
      "name": "t:sections.main-article.blocks.featured_image.name",
      "limit": 1,
      "settings": [
        {
          "type": "select",
          "id": "image_height",
          "options": [
            {
              "value": "adapt",
              "label": "t:sections.main-article.blocks.featured_image.settings.image_height.options__1.label"
            },
            {
              "value": "small",
              "label": "t:sections.main-article.blocks.featured_image.settings.image_height.options__2.label"
            },
            {
              "value": "medium",
